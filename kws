#!/usr/bin/env bash
# 知识库浏览器服务管理
# 用法: ./kws {start|stop|restart|status}
set -euo pipefail
cd "$(dirname "$0")"

PID_FILE=.kws.pid
LOG_FILE=kws.log

is_running() {
  [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null
}

current_port() {
  node -e "try{console.log(JSON.parse(require('fs').readFileSync('config.json','utf8')).port||8080)}catch(e){console.log(8080)}"
}

start() {
  if is_running; then
    echo "已在运行 (PID $(cat "$PID_FILE"))"
    exit 0
  fi
  nohup node server/index.js >> "$LOG_FILE" 2>&1 &
  echo $! > "$PID_FILE"
  # 等待服务就绪（最多 6 秒）
  for _ in $(seq 1 20); do
    is_running || break
    curl -sf -o /dev/null "http://127.0.0.1:$(current_port)/login.html" 2>/dev/null && break
    sleep 0.3
  done
  if is_running && curl -sf -o /dev/null "http://127.0.0.1:$(current_port)/login.html" 2>/dev/null; then
    echo "已启动 (PID $(cat "$PID_FILE"))，访问 http://localhost:$(current_port)"
  else
    echo "启动失败，查看日志: tail $LOG_FILE"
    exit 1
  fi
}

stop() {
  if is_running; then
    kill "$(cat "$PID_FILE")"
    echo "已停止"
  else
    echo "未在运行"
  fi
  rm -f "$PID_FILE"
}

case "${1:-}" in
  start)   start ;;
  stop)    stop ;;
  restart) stop; start ;;
  status)  if is_running; then echo "运行中 (PID $(cat "$PID_FILE"))"; else echo "未运行"; fi ;;
  *)       echo "用法: $0 {start|stop|restart|status}"; exit 1 ;;
esac
